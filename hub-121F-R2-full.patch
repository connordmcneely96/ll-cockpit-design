+    .prepare(`SELECT brief_id FROM design_deployments WHERE slug = ? LIMIT 1`)
+    .bind(candidate)
+    .first<{ brief_id: string }>()
+
+  if (!takenAgain) return candidate
+
+  return `${base}-${briefId.slice(0, 12)}`
+}
