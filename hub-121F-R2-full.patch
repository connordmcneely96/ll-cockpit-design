-      .filter(Boolean)
-      .join(', ')
+  let slug: string
+  try {
+    slug = await resolveSlugForBrief(env, briefId, clientName)
+  } catch (err) {
     return {
       ok: false,
-      code: 'MISSING_SECRETS',
-      error: `Missing Cloudflare secrets: ${missing}. Run: wrangler secret put CLOUDFLARE_API_TOKEN and wrangler secret put CLOUDFLARE_ACCOUNT_ID`,
+      code: 'SLUG_ERROR',
+      error: `Failed to resolve deployment slug: ${err instanceof Error ? err.message : String(err)}`,
